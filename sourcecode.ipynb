# ---- (Optional) find optimal threshold for information ----
dist_train = np.sqrt(fpr_train**2 + (1 - tpr_train)**2)
optimal_idx_train = np.argmin(dist_train)
optimal_threshold_train = thresholds_train[optimal_idx_train]
